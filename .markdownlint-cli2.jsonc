{
  // Markdownlint config for the skills repo. These are prose/docs, not code,
  // so the prose-hostile and purely-cosmetic rules are disabled; the remaining
  // default rules still catch real defects (reversed/empty links, stray
  // hard tabs, trailing spaces, multiple top-level headings, etc.).
  "config": {
    "default": true,

    // Prose formatting — long lines and table column alignment are deliberate.
    "MD013": false, // line-length
    "MD060": false, // table-column-style

    // Spacing/blank-line cosmetics around blocks. Worth revisiting in a
    // dedicated formatting pass, but not a gate on content correctness today.
    "MD012": false, // multiple consecutive blank lines
    "MD022": false, // blanks around headings
    "MD031": false, // blanks around fenced code
    "MD032": false, // blanks around lists
    "MD058": false, // blanks around tables

    // Authoring style the skills use intentionally.
    "MD024": false, // duplicate headings (repeated section names across phases)
    "MD026": false, // trailing punctuation in headings
    "MD028": false, // blank line inside blockquote
    "MD029": false, // ordered-list prefix numbering
    "MD034": false, // bare URLs
    "MD036": false, // emphasis used as a pseudo-heading
    "MD040": false, // fenced code language (many blocks are plain output/trees)
    "MD041": false, // first line in file must be a top-level heading
    "MD001": false  // heading increment
  },
  "globs": ["skills/**/*.md", "README.md"],
  "ignores": ["**/node_modules/**"]
}
